{
  "private": true,
  "type": "module",
  "lint-staged": {
    "resources/js/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "resources/js/**/*.css": "prettier --write"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "concurrently  \"php artisan config:cache\" \"php artisan serve --host 127.0.0.1 --port 8000\" \"npm run dev \"  ",
    "lint": "eslint resources/js --ext .js,.ts,.tsx",
    "format:write": "prettier resources/js --write",
    "format:check": "prettier resources/js --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@popperjs/core": "^2.11.6",
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/eslint-plugin-query": "^5.86.0",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.20",
    "axios": "^1.6.4",
    "bootstrap": "^5.2.3",
    "concurrently": "^9.0.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jiti": "^2.5.1",
    "laravel-vite-plugin": "^1.0.0",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.56.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.87.1",
    "i18next": "^25.5.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "react-i18next": "^15.0.2",
    "react-router-dom": "^6.26.2",
    "zustand": "^5.0.0-rc.2"
  }
}
